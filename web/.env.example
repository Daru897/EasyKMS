# Optional; no cloud keys are needed.
DATABASE_PATH=./data/easykms.sqlite
# For a reverse proxy or hosted deployment, set the exact browser origin (no trailing slash).
# APP_ORIGIN=https://easykms.example.com
# Set true for HTTPS deployments. Keep false for local HTTP.
COOKIE_SECURE=false
MAX_DEMO_WORKSPACES=1000

# Optional authenticated team mode. These values stay on the server.
# The auth config endpoint exposes ONLY the public Supabase URL and anonymous/publishable key.
# DATABASE_URL=postgresql://app_user:password@your-managed-postgres:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# DATABASE_SSL=disable  # Local database only; hosted connections require TLS by default.

# Optional Google Drive OAuth. Use the same Google application configured in Supabase Auth.
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# TOKEN_ENCRYPTION_KEY=64-hex-characters-generated-with-openssl-rand-hex-32

# Optional AI-assisted retrieval and summaries. No default model is assumed.
# OPENAI_API_KEY=your-server-key
# AI_MODEL=your-evaluated-model-id
AI_EVALUATION_APPROVED=false
